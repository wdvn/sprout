#pass "-I./lib/wgvk/include/external"
#pass "-I./lib/wgvk/include"
#pass "-L./lib/wgvk/build/libwgvk.a"
#pass "-I./lib/RGFW/include"
#pass "-L./lib/RGFW/lib"
#pass "-lRGFW"
//TODO: compile with static lib
//#pass "./lib/RGFW/lib/libRGFW.a"
#pass "-lX11"
#pass "-v"
#pass "-L/usr/lib/x86_64-linux-gnu/libGL.so"
#pass "-lGL"

use "sprout/src/c"
use "sprout/src/rgfw"
use "sprout/src/wgvk"
use "std/fmt"
use "std/mem"

struct LoopContext {
	window:       *rgfw::RGFW_Window
	surface:      wgvk::WGPUSurface
	device:       wgvk::WGPUDevice
	queue:        wgvk::WGPUQueue
	vertexBuffer: wgvk::WGPUBuffer
	rp:           wgvk::WGPURenderPipeline
}

const simpleShaderWGSL: str = `
struct VertexInput {
    @location(0) position: vec2f
};
struct VertexOutput {
    @builtin(position) position: vec4f
};
@vertex
fn vs_main(in: VertexInput) -> VertexOutput {
    var out: VertexOutput;
    out.position = vec4f(in.position.x, in.position.y, 0.0f, 1.0f);
    return out;
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4f {
    return vec4f(1,0,0,1);
}
`

// make loop render
fn mainLoop(mut data: &LoopContext) {
	mut context := data
	let mut event = rgfw::RGFW_event{}
	for rgfw::RGFW_window_checkEvent(context.window, &event) == rgfw::RGFW_TRUE {
		if event._type == rgfw::RGFW_quit {
			break
		}
		if event._type == rgfw::RGFW_mouseButtonPressed && event.button == rgfw::RGFW_mouseButton.RGFW_mouseLeft {
			fmt::Println("You clicked at x: %d, y: %d\n", event.point.x, event.point.y)
		}
	}
	mut surfaceTexture := wgvk::WGPUSurfaceTexture{}
	wgvk::WgpuSurfaceGetCurrentTexture(context.surface, &surfaceTexture)

	if (surfaceTexture.status != wgvk::WGPUSurfaceGetCurrentTextureStatus.WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal) {
		let surfaceConfig = wgvk::WGPUSurfaceConfiguration{
			alphaMode: wgvk::WGPUCompositeAlphaMode.WGPUCompositeAlphaMode_Opaque,
			presentMode: wgvk::WGPUPresentMode.WGPUPresentMode_Fifo,
			device: context.device,
			format: wgvk::WGPUTextureFormat.WGPUTextureFormat_BGRA8Unorm,
			width: 1000,
			height: 1000,
		}
		wgvk::WgpuSurfaceConfigure(context.surface, &surfaceConfig)
		wgvk::WgpuSurfaceGetCurrentTexture(context.surface, &surfaceTexture)
	}
	let viewDescriptor = wgvk::WGPUTextureViewDescriptor{
		baseArrayLayer: 0,
		arrayLayerCount: 1,
		baseMipLevel: 0,
		mipLevelCount: 1,
		format: wgvk::WGPUTextureFormat.WGPUTextureFormat_BGRA8Unorm,
		dimension: wgvk::WGPUTextureViewDimension.WGPUTextureViewDimension_2D,
		usage: wgvk::WGPUTextureUsage_RenderAttachment,
		aspect: wgvk::WGPUTextureAspect.WGPUTextureAspect_All,
	}
	let mut surfaceView = wgvk::WgpuTextureCreateView(surfaceTexture.texture, &viewDescriptor)
	let mut cenc = wgvk::WgpuDeviceCreateCommandEncoder(context.device, nil)
	let bgColor = wgvk::WGPUColor{0.5, 0.2, 0, 0.5}
	let mut colorAttachment = wgvk::WGPURenderPassColorAttachment{
		clearValue: bgColor,
		loadOp: wgvk::WGPULoadOp.WGPULoadOp_Clear,
		storeOp: wgvk::WGPUStoreOp.WGPUStoreOp_Store,
		view: surfaceView,
	}
	let rpdes = wgvk::WGPURenderPassDescriptor{
		colorAttachmentCount: 1,
		colorAttachments: &colorAttachment,
	}
	let rpenc = wgvk::WgpuCommandEncoderBeginRenderPass(cenc, &rpdes)
	wgvk::WgpuRenderPassEncoderSetPipeline(rpenc, context.rp)
	wgvk::WgpuRenderPassEncoderSetVertexBuffer(rpenc, 0, context.vertexBuffer, 0, wgvk::WGPU_WHOLE_SIZE)
	wgvk::WgpuRenderPassEncoderDraw(rpenc, 3, 1, 0, 0)
	wgvk::WgpuRenderPassEncoderEnd(rpenc)

	let mut cBuffer = wgvk::WgpuCommandEncoderFinish(cenc, nil)
	wgvk::WgpuQueueSubmit(context.queue, 1, &cBuffer)
	wgvk::WgpuCommandEncoderRelease(cenc)
	wgvk::WgpuCommandBufferRelease(cBuffer)
	wgvk::WgpuRenderPassEncoderRelease(rpenc)
	wgvk::WgpuTextureViewRelease(surfaceView)
}

fn adapterCallbackFunction(
	status: wgvk::WGPURequestAdapterStatus,
	adapter: wgvk::WGPUAdapter,
	label: wgvk::WGPUStringView,
	mut userdata1: c::Void,
	mut userdata2: c::Void) {
	unsafe { userdata1 = (c::Void)(&adapter) }
}
fn deviceCallbackFunction(
	status: wgvk::WGPURequestDeviceStatus,
	device: wgvk::WGPUDevice,
	message: wgvk::WGPUStringView,
	mut userdata1: c::Void,
	mut userdata2: c::Void) {
	unsafe { userdata1 = (c::Void)(&device) }
}
fn main() {
	let mut instanceFeatures: []wgvk::WGPUInstanceFeatureName = [
		wgvk::WGPUInstanceFeatureName.WGPUInstanceFeatureName_TimedWaitAny,
		wgvk::WGPUInstanceFeatureName.WGPUInstanceFeatureName_ShaderSourceSPIRV,
	]
	let mut instanceDescriptor = wgvk::WGPUInstanceDescriptor{
		nextInChain: nil,
		requiredFeatures: instanceFeatures,
		requiredFeatureCount: 2,
	}
	let mut instance = wgvk::WgpuCreateInstance(&instanceDescriptor)
	let mut adapterOptions = wgvk::WGPURequestAdapterOptions{featureLevel: wgvk::WGPUFeatureLevel.WGPUFeatureLevel_Core}
	let requestedAdapter: wgvk::WGPUAdapter = wgvk::WGPUAdapter{}
	let adapterCallback = wgvk::WGPURequestAdapterCallbackInfo{
		mode: wgvk::WGPUCallbackMode.WGPUCallbackMode_WaitAnyOnly,
		callback: adapterCallbackFunction,
		userdata1: unsafe { c::CastToVoid(requestedAdapter) },
	}

	let aFuture = wgvk::WgpuInstanceRequestAdapter(instance, &adapterOptions, adapterCallback)
	let winfo = wgvk::WGPUFutureWaitInfo{future: aFuture, completed: 0}
	let deviceLabel = wgvk::NewWGPUStringView("1234")
	let deviceDescriptor = wgvk::WGPUDeviceDescriptor{label: deviceLabel}

	let mut device: wgvk::WGPUDevice = wgvk::WGPUDevice{}
	let requestDeviceCallbackInfo = wgvk::WGPURequestDeviceCallbackInfo{
		callback: deviceCallbackFunction,
		mode: wgvk::WGPUCallbackMode.WGPUCallbackMode_WaitAnyOnly,
		userdata1: unsafe { c::CastToVoid(device) },
	}
	let requestDeviceFuture = wgvk::WgpuAdapterRequestDevice(requestedAdapter, &deviceDescriptor, requestDeviceCallbackInfo)
	let requestDeviceFutureWaitInfo = wgvk::WGPUFutureWaitInfo{future: requestDeviceFuture, completed: 0}
	wgvk::WgpuInstanceWaitAny(instance, 1, &requestDeviceFutureWaitInfo, 1000)
	let queue = wgvk::WgpuDeviceGetQueue(device)
	let winRec = rgfw::RGFW_rect{0, 0, 1280, 720}
	let mut window = rgfw::RGFW_createWindow("RGFW with WebGPU", 0, 0, 1280, 720, 0)
	let surface = wgvk::RGFW_window_createSurface_WebGPU(window, instance)
	let mut width: u32 = 0
	let mut height: u32 = 0

	let mut caps = wgvk::WGPUSurfaceCapabilities{}
	wgvk::WgpuSurfaceGetCapabilities(surface, requestedAdapter, &caps)
	let desiredPresentMode = wgvk::WGPUPresentMode.WGPUPresentMode_Fifo

	let surfaceConfig = wgvk::WGPUSurfaceConfiguration{
		alphaMode: wgvk::WGPUCompositeAlphaMode.WGPUCompositeAlphaMode_Opaque,
		presentMode: desiredPresentMode,
		usage: wgvk::WGPUTextureUsage_RenderAttachment,
		device: device,
		format: wgvk::WGPUTextureFormat.WGPUTextureFormat_BGRA8Unorm,
		width: width,
		height: height,
	}
	wgvk::WgpuSurfaceConfigure(surface, &surfaceConfig)
	let shaderSource = wgvk::WGPUShaderSourceWGSL{
		chain: wgvk::WGPUChainedStruct{
			sType: wgvk::WGPUSType.WGPUSType_ShaderSourceWGSL,
		},
		code: wgvk::WGPUStringView{data: unsafe { c::StrToCharPtr(simpleShaderWGSL) }, length: (u32)(mem::SizeOf(simpleShaderWGSL) - 1)},
	}
	let shaderModuleDesc = wgvk::WGPUShaderModuleDescriptor{nextInChain: &shaderSource.chain}
	let shaderModule = wgvk::WgpuDeviceCreateShaderModule(device, &shaderModuleDesc)

	let vbAttribute = wgvk::WGPUVertexAttribute{
		nextInChain: nil,
		shaderLocation: 0,
		format: wgvk::WGPUVertexFormat.WGPUVertexFormat_Float32x2,
		offset: 0,
	}
	let vbLayout = wgvk::WGPUVertexBufferLayout{
		nextInChain: nil,
		arrayStride: (u64)(mem::SizeOf((f32)(0)) * 2),
		attributeCount: 1,
		attributes: &vbAttribute,
		stepMode: wgvk::WGPUVertexStepMode.WGPUVertexStepMode_Vertex,
	}
	let blendState = wgvk::WGPUBlendState{
		alpha: wgvk::WGPUBlendComponent{
			operation: wgvk::WGPUBlendOperation.WGPUBlendOperation_Add,
			srcFactor: wgvk::WGPUBlendFactor.WGPUBlendFactor_One,
			dstFactor: wgvk::WGPUBlendFactor.WGPUBlendFactor_One,
		},
		color: wgvk::WGPUBlendComponent{
			operation: wgvk::WGPUBlendOperation.WGPUBlendOperation_Add,
			srcFactor: wgvk::WGPUBlendFactor.WGPUBlendFactor_One,
			dstFactor: wgvk::WGPUBlendFactor.WGPUBlendFactor_One,
		},
	}
	let colorTargetState = wgvk::WGPUColorTargetState{
		writeMask: wgvk::WGPUColorWriteMask_All,
		format: wgvk::WGPUTextureFormat.WGPUTextureFormat_BGRA8Unorm,
		blend: nil,
	}
	let fragmentState = wgvk::WGPUFragmentState{
		entryPoint: wgvk::NewWGPUStringView("fs_main"),
		module: shaderModule,
		targetCount: 1,
		targets: &colorTargetState,
	}
	let pldesc = wgvk::WGPUPipelineLayoutDescriptor{}
	let pllayout = wgvk::WgpuDeviceCreatePipelineLayout(device, &pldesc)

	let rpdesc = wgvk::WGPURenderPipelineDescriptor{
		vertex: wgvk::WGPUVertexState{
			bufferCount: 1,
			buffers: &vbLayout,
			module: shaderModule,
			entryPoint: wgvk::NewWGPUStringView("vs_main"),
		},
		fragment: &fragmentState,
		primitive: wgvk::WGPUPrimitiveState{
			cullMode: wgvk::WGPUCullMode.WGPUCullMode_None,
			frontFace: wgvk::WGPUFrontFace.WGPUFrontFace_CCW,
			topology: wgvk::WGPUPrimitiveTopology.WGPUPrimitiveTopology_TriangleList,
		},
		layout: pllayout,
		multisample: wgvk::WGPUMultisampleState{
			count: 1,
			mask: 0xffffffff,
		},
	}
	let rp = wgvk::WgpuDeviceCreateRenderPipeline(device, &rpdesc)
	let scale: f32 = 0.2
	let vertices: []f32 = [-scale, -scale, -scale, scale, scale, scale]

	let bufferDescriptor = wgvk::WGPUBufferDescriptor{
		size: (wgvk::uint64_t)(mem::SizeOf(vertices)),
		usage: wgvk::WGPUBufferUsage_Vertex | wgvk::WGPUBufferUsage_CopyDst,
	}
	let vertexBuffer = wgvk::WgpuDeviceCreateBuffer(device, &bufferDescriptor)
	wgvk::WgpuQueueWriteBuffer(queue, vertexBuffer, 0, vertices, mem::SizeOf(vertices))

	let rbEncDesc = wgvk::WGPURenderBundleEncoderDescriptor{
		colorFormatCount: 1,
		colorFormats: &colorTargetState.format,
		depthStencilFormat: wgvk::WGPUTextureFormat.WGPUTextureFormat_Undefined,
		sampleCount: 1,
	}

	mut ctx := LoopContext{
		window: window,
		surface: surface,
		device: device,
		queue: queue,
		vertexBuffer: vertexBuffer,
		rp: rp,
	}

	fmt::Println("start")
}