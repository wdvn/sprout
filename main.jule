#pass "-I./lib/RGFW/include -L./lib/RGFW/lib -lRGFW -lX11 -v"

fn main() {
    println("Let's start")
    let mut window = RGFW_createWindow("Hello RGFW",0,0,800,600, RGFW_windowNoResize);
    for (RGFW_window_shouldClose(window)) {
        //cpp.RGFW_window_clear(window, 255, 255, 255);
    }
    RGFW_window_close(window);
}