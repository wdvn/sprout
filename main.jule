#pass "-Ilib/RGFW/include -Llib/RGFW/lib -lRGFW -lX11"

fn main() {
    println("Let's start")
    let mut window = RGFW_createWindow("Hello RGFW",0,0,800,600, RGFW_windowNoResize);
    for (cpp.RGFW_window_shouldClose(window)) {
        //cpp.RGFW_window_clear(window, 255, 255, 255);
    }
    cpp.RGFW_window_close(window);
}