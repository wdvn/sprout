cpp type RGFW_mouseButton: u8
type RGFW_mouseButton = cpp.RGFW_mouseButton

let RGFW_mouseLeft: RGFW_mouseButton = 0                            /*!< left mouse button is pressed */
let RGFW_mouseMiddle: RGFW_mouseButton = RGFW_mouseLeft + 1         /*!< mouse-wheel-button is pressed */
let RGFW_mouseRight: RGFW_mouseButton = RGFW_mouseMiddle + 1        /*!< right mouse button is pressed */
let RGFW_mouseScrollUp: RGFW_mouseButton = RGFW_mouseRight + 1      /*!< mouse wheel is scrolling up */
let RGFW_mouseScrollDown: RGFW_mouseButton = RGFW_mouseScrollUp + 1 /*!< mouse wheel is scrolling down */
let RGFW_mouseMisc1: RGFW_mouseButton = RGFW_mouseScrollDown + 1
let RGFW_mouseMisc2: RGFW_mouseButton = RGFW_mouseMisc1 + 1
let RGFW_mouseMisc3: RGFW_mouseButton = RGFW_mouseMisc2 + 1
let RGFW_mouseMisc4: RGFW_mouseButton = RGFW_mouseMisc3 + 1
let RGFW_mouseMisc5: RGFW_mouseButton = RGFW_mouseMisc4 + 1
let RGFW_mouseFinal: RGFW_mouseButton = RGFW_mouseMisc5 + 1

