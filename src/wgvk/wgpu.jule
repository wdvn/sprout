cpp fn wgpuCreateInstance(): WGPUInstance
fn WgpuCreateInstance(): WGPUInstance {
	ret unsafe { cpp.wgpuCreateInstance() }
}

cpp fn wgpuSurfaceGetCurrentTexture(surface: WGPUSurface, texture: *WGPUSurfaceTexture)
fn WgpuSurfaceGetCurrentTexture(surface: WGPUSurface, texture: *WGPUSurfaceTexture) {
	unsafe { cpp.wgpuSurfaceGetCurrentTexture(surface, texture) }
}

cpp fn wgpuSurfaceConfigure(surface: WGPUSurface, config: *WGPUSurfaceConfiguration)
fn WgpuSurfaceConfigure(surface: WGPUSurface, config: *WGPUSurfaceConfiguration) {
	unsafe { cpp.wgpuSurfaceConfigure(surface, config) }
}