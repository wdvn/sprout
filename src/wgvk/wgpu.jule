	colorAttachmentCount:   u32
	colorAttachments:       *WGPURenderPassColorAttachment
	depthStencilAttachment: *WGPURenderPassDepthStencilAttachment
	occlusionQuerySet:      WGPUQuerySet
	timestampWrites:        WGPUPassTimestampWrites
}

type WGPURenderPassDescriptor = cpp.WGPURenderPassDescriptor

#typedef
cpp struct WGPURenderPassDepthStencilAttachment {
	nextInChain:       *WGPUChainedStruct
	view:              WGPUTextureView
	depthLoadOp:       WGPULoadOp
	depthStoreOp:      WGPUStoreOp
	depthClearValue:   f32
	depthReadOnly:     u32
	stencilLoadOp:     WGPULoadOp
	stencilStoreOp:    WGPUStoreOp
	stencilClearValue: u32
	stencilReadOnly:   u32
}

type WGPURenderPassDepthStencilAttachment = cpp.WGPURenderPassDepthStencilAttachment

#typedef
cpp struct WGPUPassTimestampWrites {
	nextInChain:               WGPUChainedStruct
	querySet:                  WGPUQuerySet
	beginningOfPassWriteIndex: u32
	endOfPassWriteIndex:       u32
}

type WGPUPassTimestampWrites = cpp.WGPUPassTimestampWrites

#typedef
cpp struct WGPUTexelCopyBufferInfo {
	layout: WGPUTexelCopyBufferLayout
	buffer: WGPUBuffer
}

#typedef
cpp struct WGPUTexelCopyBufferLayout {
	offset:       u64
	bytesPerRow:  u32
	rowsPerImage: u32
}

#typedef
cpp struct WGPUTexelCopyTextureInfo {
	texture:  WGPUTexture
	mipLevel: u32
	origin:   WGPUOrigin3D
	aspect:   WGPUTextureAspect
}

#typedef
cpp struct WGPUExtent3D {
	width:              u32
	height:             u32
	depthOrArrayLayers: u32
}

#typedef
cpp struct WGPUOrigin3D {
	x: u32
	y: u32
	z: u32
}

#typedef
cpp struct WGPUCommandBufferDescriptor {
	nextInChain: WGPUChainedStruct
	label:       WGPUStringView
}

#typedef
cpp struct WGPULimits {
	nextInChain:                               *WGPUChainedStruct
	maxTextureDimension1D:                     u32
	maxTextureDimension2D:                     u32
	maxTextureDimension3D:                     u32
	maxTextureArrayLayers:                     u32
	maxBindGroups:                             u32
	maxBindGroupsPlusVertexBuffers:            u32
	maxBindingsPerBindGroup:                   u32
	maxDynamicUniformBuffersPerPipelineLayout: u32
	maxDynamicStorageBuffersPerPipelineLayout: u32
	maxSampledTexturesPerShaderStage:          u32
	maxSamplersPerShaderStage:                 u32
	maxStorageBuffersPerShaderStage:           u32
	maxStorageTexturesPerShaderStage:          u32
	maxUniformBuffersPerShaderStage:           u32
	maxUniformBufferBindingSize:               u32
	maxStorageBufferBindingSize:               u32
	minUniformBufferOffsetAlignment:           u32
	minStorageBufferOffsetAlignment:           u32
	maxVertexBuffers:                          u32
	maxBufferSize:                             u32
	maxVertexAttributes:                       u32
	maxVertexBufferArrayStride:                u32
	maxInterStageShaderVariables:              u32
	maxColorAttachments:                       u32
	maxColorAttachmentBytesPerSample:          u32
	maxComputeWorkgroupStorageSize:            u32
	maxComputeInvocationsPerWorkgroup:         u32
	maxComputeWorkgroupSizeX:                  u32
	maxComputeWorkgroupSizeY:                  u32
	maxComputeWorkgroupSizeZ:                  u32
	maxComputeWorkgroupsPerDimension:          u32
	maxStorageBuffersInVertexStage:            u32
	maxStorageTexturesInVertexStage:           u32
	maxStorageBuffersInFragmentStage:          u32
	maxStorageTexturesInFragmentStage:         u32
}

#typedef
cpp struct WGPUQueueDescriptor {
	nextInChain: *WGPUChainedStruct
	label:       WGPUStringView
}

#typedef
cpp struct WGPUDeviceLostCallbackInfo {
	nextInChain: *WGPUChainedStruct
	mode:        int
	callback:    WGPUDeviceLostCallback
	userdata1:   c::Void
	userdata2:   c::Void
}

#typedef
cpp struct WGPUUncapturedErrorCallbackInfo {
	nextInChain: *WGPUChainedStruct
	callback:    WGPUUncapturedErrorCallback
	userdata1:   c::Void
	userdata2:   c::Void
}

#typedef
cpp struct WGPUShaderSourceWGSL {
	chain: WGPUChainedStruct
	code:  WGPUStringView
}

#typedef
cpp struct WGPUBlendComponent {
	operation: u32 //WGPUBlendOperation
	srcFactor: u32 //WGPUBlendFactor
	dstFactor: u32 //WGPUBlendFactor
}

#typedef
cpp struct WGPUConstantEntry {
	nextInChain: *WGPUChainedStruct
	key:         WGPUStringView
	value:       f64
}

#typedef
cpp struct WGPUVertexState {
	nextInChain:   *WGPUChainedStruct
	module:        WGPUShaderModule
	entryPoint:    WGPUStringView
	constantCount: size_t
	constants:     *WGPUConstantEntry
	bufferCount:   size_t
	buffers:       *WGPUVertexBufferLayout
}

#typedef
cpp struct WGPUPrimitiveState {
	nextInChain:      *WGPUChainedStruct
	topology:         WGPUPrimitiveTopology
	stripIndexFormat: WGPUIndexFormat
	frontFace:        WGPUFrontFace
	cullMode:         WGPUCullMode
	unclippedDepth:   Bool32
}

#typedef
cpp struct WGPUDepthStencilState {
	nextInChain: *WGPUChainedStruct

	format:              WGPUTextureFormat
	depthWriteEnabled:   Bool32
	depthCompare:        WGPUCompareFunction
	stencilFront:        WGPUStencilFaceState
	stencilBack:         WGPUStencilFaceState
	stencilReadMask:     uint32_t
	stencilWriteMask:    uint32_t
	depthBias:           int32_t
	depthBiasSlopeScale: float
	depthBiasClamp:      float
}

#typedef
cpp struct WGPUMultisampleState {
	nextInChain: *WGPUChainedStruct

	count:                  uint32_t
	mask:                   uint32_t
	alphaToCoverageEnabled: Bool32
}

#typedef
cpp struct WGPUStencilFaceState {
	compare:     WGPUCompareFunction
	failOp:      WGPUStencilOperation
	depthFailOp: WGPUStencilOperation
	passOp:      WGPUStencilOperation
}

//---------------------------------------------------
cpp type WGPURequestAdapterCallback: fn(WGPURequestAdapterStatus, WGPUAdapter, WGPUStringView, mut c::Void, mut c::Void)
cpp type WGPURequestDeviceCallback: fn(WGPURequestDeviceStatus, WGPUDevice, WGPUStringView, mut c::Void, mut c::Void)
cpp type WGPUProc: fn()
cpp type WGPUDeviceLostCallback: fn(*WGPUDevice, WGPUDeviceLostReason, WGPUStringView, c::Void, c::Void)
cpp type WGPUUncapturedErrorCallback: fn(*WGPUDevice, WGPUErrorType, WGPUStringView, c::Void, c::Void)

