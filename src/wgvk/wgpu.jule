	constantCount: size_t
	constants:     *WGPUConstantEntry
	targetCount:   size_t
	targets:       *WGPUColorTargetState
}

type WGPUFragmentState = cpp.WGPUFragmentState

#typedef
cpp struct WGPUPipelineLayoutDescriptor{}

type WGPUPipelineLayoutDescriptor = cpp.WGPUPipelineLayoutDescriptor

#typedef
cpp struct WGPURenderPipelineDescriptor {
	nextInChain:  *WGPUChainedStruct
	label:        WGPUStringView
	layout:       WGPUPipelineLayout
	vertex:       WGPUVertexState
	primitive:    WGPUPrimitiveState
	depthStencil: *WGPUDepthStencilState
	multisample:  WGPUMultisampleState
	fragment:     *WGPUFragmentState
}

type WGPURenderPipelineDescriptor = cpp.WGPURenderPipelineDescriptor

#typedef
cpp struct WGPUBufferDescriptor{
nextInChain:*WGPUChainedStruct
 label:    WGPUStringView
 usage:    WGPUBufferUsage
 size:    uint64_t
 mappedAtCreation:    WGPUBool
}

type WGPUBufferDescriptor = cpp.WGPUBufferDescriptor

#typedef
cpp struct WGPURenderBundleEncoderDescriptor{}

type WGPURenderBundleEncoderDescriptor = cpp.WGPURenderBundleEncoderDescriptor

#typedef
cpp struct WGPUColor {
	r: f64
	g: f64
