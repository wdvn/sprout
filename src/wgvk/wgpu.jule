}

type WGPUVertexAttribute = cpp.WGPUVertexAttribute

#typedef
cpp struct WGPUVertexBufferLayout {
	nextInChain:    *WGPUChainedStruct
	stepMode:       WGPUVertexStepMode
	arrayStride:    u64
	attributeCount: u32
	attributes:     *WGPUVertexAttribute
}

type WGPUVertexBufferLayout = cpp.WGPUVertexBufferLayout

#typedef
cpp struct WGPUBlendState {
	color: WGPUBlendComponent
	alpha: WGPUBlendComponent
}

type WGPUBlendState = cpp.WGPUBlendState

#typedef
cpp struct WGPUColorTargetState {
	nextInChain: *WGPUChainedStruct
	format:      WGPUTextureFormat
	blend:       *WGPUBlendState
	writeMask:   WGPUColorWriteMask
}

type WGPUColorTargetState = cpp.WGPUColorTargetState

#typedef
cpp struct WGPUFragmentState {
	nextInChain:   *WGPUChainedStruct
	module:        WGPUShaderModule
