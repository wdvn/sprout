#typedef
cpp struct WGPUColor {
	r: f64
	g: f64
	b: f64
	a: f64
}

type WGPUColor = cpp.WGPUColor

#typedef
cpp struct WGPUSurfaceTexture {
	nextInChain: &WGPUChainedStruct
	texture:     WGPUTexture
	status:      WGPUSurfaceGetCurrentTextureStatus
}

type WGPUSurfaceTexture = cpp.WGPUSurfaceTexture

#typedef
cpp struct WGPUSurfaceConfiguration {
	nextInChain:     *WGPUChainedStruct
	device:          WGPUDevice
	format:          WGPUTextureFormat
	usage:           WGPUTextureUsage
	width:           u32
	height:          u32
	viewFormatCount: u32
	viewFormats:     &WGPUTextureFormat
	alphaMode:       WGPUCompositeAlphaMode
	presentMode:     WGPUPresentMode
}

type WGPUSurfaceConfiguration = cpp.WGPUSurfaceConfiguration

#typedef
cpp struct WGPUChainedStruct {
	next:  &cpp.WGPUChainedStruct
	sType: WGPUSType
}

type WGPUChainedStruct = cpp.WGPUChainedStruct

#typedef
cpp struct WGPUTextureViewDescriptor {
	nextInChain:     &WGPUChainedStruct
	label:           WGPUStringView
	format:          WGPUTextureFormat
	dimension:       WGPUTextureViewDimension
	baseMipLevel:    u32
	mipLevelCount:   u32
	baseArrayLayer:  u32
	arrayLayerCount: u32
	aspect:          WGPUTextureAspect
	usage:           WGPUTextureUsage
}

type WGPUTextureViewDescriptor = cpp.WGPUTextureViewDescriptor

#typedef
cpp struct WGPUCommandEncoderDescriptor {
	nextInChain: *WGPUChainedStruct
	label:       WGPUStringView
}

type WGPUCommandEncoderDescriptor = cpp.WGPUCommandEncoderDescriptor

#typedef
cpp struct WGPUInstanceLimits {
	nextInChain:          *WGPUChainedStruct
	timedWaitAnyMaxCount: u32
}

type WGPUInstanceLimits = cpp.WGPUInstanceLimits

#typedef
cpp struct WGPURenderPassColorAttachment {
	nextInChain:   *WGPUChainedStruct
	view:          WGPUTextureView
	resolveTarget: WGPUTextureView
	depthSlice:    u32
	loadOp:        WGPULoadOp
	storeOp:       WGPUStoreOp
	clearValue:    WGPUColor
}

type WGPURenderPassColorAttachment = cpp.WGPURenderPassColorAttachment

#typedef
cpp struct WGPURequestAdapterCallback{}

type WGPURequestAdapterCallback = cpp.WGPURequestAdapterCallback

#typedef
cpp struct WGPURenderPassDescriptor {
	nextInChain:            WGPUChainedStruct
	label:                  WGPUStringView
	colorAttachmentCount:   u32
	colorAttachments:       *WGPURenderPassColorAttachment
	depthStencilAttachment: *WGPURenderPassDepthStencilAttachment
	occlusionQuerySet:      WGPUQuerySet
	timestampWrites:        WGPUPassTimestampWrites
}

type WGPURenderPassDescriptor = cpp.WGPURenderPassDescriptor

#typedef
cpp struct WGPURenderPassDepthStencilAttachment {
	nextInChain:       *WGPUChainedStruct
	view:              WGPUTextureView
	depthLoadOp:       WGPULoadOp
	depthStoreOp:      WGPUStoreOp
	depthClearValue:   f32
	depthReadOnly:     u32
	stencilLoadOp:     WGPULoadOp
	stencilStoreOp:    WGPUStoreOp
	stencilClearValue: u32
	stencilReadOnly:   u32
}

type WGPURenderPassDepthStencilAttachment = cpp.WGPURenderPassDepthStencilAttachment

#typedef
cpp struct WGPUPassTimestampWrites {
	nextInChain:               WGPUChainedStruct
	querySet:                  WGPUQuerySet
	beginningOfPassWriteIndex: u32
	endOfPassWriteIndex:       u32
}

type WGPUPassTimestampWrites = cpp.WGPUPassTimestampWrites

#typedef
cpp struct WGPUTexelCopyBufferInfo {
	layout: WGPUTexelCopyBufferLayout
	buffer: WGPUBuffer
}

#typedef
cpp struct WGPUTexelCopyBufferLayout {
	offset:       u64
	bytesPerRow:  u32
	rowsPerImage: u32
}

#typedef
cpp struct WGPUTexelCopyTextureInfo {
	texture:  WGPUTexture
	mipLevel: u32
	origin:   WGPUOrigin3D
	aspect:   WGPUTextureAspect
}

#typedef
cpp struct WGPUExtent3D {
	width:              u32
	height:             u32
	depthOrArrayLayers: u32
}

#typedef
cpp struct WGPUOrigin3D {
	x: u32
	y: u32
	z: u32
}

#typedef
cpp struct WGPUCommandBufferDescriptor {
	nextInChain: WGPUChainedStruct
	label:       WGPUStringView
}

