use "sprout/src/c"

type size_t = u32
cpp type WGPUFlags: u64
type WGPUFlags = cpp.WGPUFlags
type WGPUTextureUsage = WGPUFlags

const WGPUTextureUsage_None: WGPUTextureUsage = 0x0000000000000000
const WGPUTextureUsage_CopySrc: WGPUTextureUsage = 0x0000000000000001
const WGPUTextureUsage_CopyDst: WGPUTextureUsage = 0x0000000000000002
const WGPUTextureUsage_TextureBinding: WGPUTextureUsage = 0x0000000000000004
const WGPUTextureUsage_StorageBinding: WGPUTextureUsage = 0x0000000000000008
const WGPUTextureUsage_RenderAttachment: WGPUTextureUsage = 0x0000000000000010
const WGPUTextureUsage_TransientAttachment: WGPUTextureUsage = 0x0000000000001000
const WGPUTextureUsage_StorageAttachment: WGPUTextureUsage = 0x0000000000002000

cpp type WGPUBool: u32
type WGPUBool = cpp.WGPUBool
cpp type Bool32: u32

#typedef
cpp struct WGPUInstanceDescriptor {
	nextInChain:          *WGPUChainedStruct
	requiredFeatureCount: u32
	requiredFeatures:     []WGPUInstanceFeatureName
	requiredLimits:       *WGPUInstanceLimits
}

type WGPUInstanceDescriptor = cpp.WGPUInstanceDescriptor

#typedef
cpp struct WGPURequestAdapterOptions {
	nextInChain:          *WGPUChainedStruct
	featureLevel:         WGPUFeatureLevel
	powerPreference:      WGPUPowerPreference
	forceFallbackAdapter: WGPUBool
	backendType:          WGPUBackendType
	compatibleSurface:    *WGPUSurface
}

type WGPURequestAdapterOptions = cpp.WGPURequestAdapterOptions

#typedef
cpp struct WGPURequestAdapterCallbackInfo {
	nextInChain: WGPUChainedStruct
	mode:        WGPUCallbackMode
	callback:    WGPURequestAdapterCallback
	userdata1:   c::Void
	userdata2:   c::Void
}

type WGPURequestAdapterCallbackInfo = cpp.WGPURequestAdapterCallbackInfo

