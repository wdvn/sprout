fn WgpuQueueWriteBuffer(cSelf: WGPUQueue, buffer: WGPUBuffer, bufferOffset: uint64_t, data: any, size: size_t) {
	let raw = unsafe { c::CastToVoid(data) }
	unsafe { cpp.wgpuQueueWriteBuffer(cSelf, buffer, bufferOffset, raw, size) }
}