fn RGFW_BIT(x: u32): u32 {
	ret 1 << x
}

//enum
type RGFW_windowFlags = u32

let RGFW_windowNoInitAPI: RGFW_windowFlags = RGFW_BIT(0)
let RGFW_windowNoBorder: RGFW_windowFlags = RGFW_BIT(1)
let RGFW_windowNoResize: RGFW_windowFlags = RGFW_BIT(2)
let RGFW_windowAllowDND: RGFW_windowFlags = RGFW_BIT(3)
let RGFW_windowHideMouse: RGFW_windowFlags = RGFW_BIT(4)
let RGFW_windowFullscreen: RGFW_windowFlags = RGFW_BIT(5)
let RGFW_windowTransparent: RGFW_windowFlags = RGFW_BIT(6)
let RGFW_windowCenter: RGFW_windowFlags = RGFW_BIT(7)
let RGFW_windowOpenglSoftware: RGFW_windowFlags = RGFW_BIT(8)
let RGFW_windowCocoaCHDirToRes: RGFW_windowFlags = RGFW_BIT(9)
let RGFW_windowScaleToMonitor: RGFW_windowFlags = RGFW_BIT(10)
let RGFW_windowHide: RGFW_windowFlags = RGFW_BIT(11)
let RGFW_windowMaximize: RGFW_windowFlags = RGFW_BIT(12)
let RGFW_windowCenterCursor: RGFW_windowFlags = RGFW_BIT(13)
let RGFW_windowFloating: RGFW_windowFlags = RGFW_BIT(14)
let RGFW_windowFreeOnClose: RGFW_windowFlags = RGFW_BIT(15)
let RGFW_windowFocusOnShow: RGFW_windowFlags = RGFW_BIT(16)
let RGFW_windowMinimize: RGFW_windowFlags = RGFW_BIT(17)
let RGFW_windowFocus: RGFW_windowFlags = RGFW_BIT(18)
let RGFW_windowedFullscreen: RGFW_windowFlags = RGFW_BIT(1) | RGFW_BIT(12)

cpp type RGFW_eventType: u32
type RGFW_eventType = cpp.RGFW_eventType

let RGFW_eventNone: RGFW_eventType = 0
let RGFW_keyPressed: RGFW_eventType = RGFW_eventNone + 1
let RGFW_keyReleased: RGFW_eventType = RGFW_keyPressed + 1
let RGFW_mouseButtonPressed: RGFW_eventType = RGFW_keyReleased + 1
let RGFW_mouseButtonReleased: RGFW_eventType = RGFW_mouseButtonPressed + 1
let RGFW_mousePosChanged: RGFW_eventType = RGFW_mouseButtonReleased + 1
let RGFW_windowMoved: RGFW_eventType = RGFW_mousePosChanged + 1
let RGFW_windowResized: RGFW_eventType = RGFW_windowMoved + 1
let RGFW_focusIn: RGFW_eventType = RGFW_windowResized + 1
let RGFW_focusOut: RGFW_eventType = RGFW_focusIn + 1
let RGFW_mouseEnter: RGFW_eventType = RGFW_focusOut + 1
let RGFW_mouseLeave: RGFW_eventType = RGFW_mouseEnter + 1
let RGFW_windowRefresh: RGFW_eventType = RGFW_mouseLeave + 1
let RGFW_quit: RGFW_eventType = RGFW_windowRefresh + 1
let RGFW_DND: RGFW_eventType = RGFW_quit + 1
let RGFW_DNDInit: RGFW_eventType = RGFW_DND + 1
let RGFW_windowMaximized: RGFW_eventType = RGFW_DNDInit + 1
let RGFW_windowMinimized: RGFW_eventType = RGFW_windowMaximized + 1
let RGFW_windowRestored: RGFW_eventType = RGFW_windowMinimized + 1
let RGFW_scaleUpdated: RGFW_eventType = RGFW_windowRestored + 1

cpp type RGFW_bool: u8
type RGFW_bool = cpp.RGFW_bool

const RGFW_TRUE: RGFW_bool = 1
const RGFW_FALSE: RGFW_bool = 0